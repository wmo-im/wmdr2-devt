{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wmo-im.github.io/wmdr2-devt/schemas/wmdr2-record-feature.schema.json",
  "title": "WMDR2 development Facility record",
  "description": "WMDR2 development record schema. Compatible pieces are constrained directly by the pinned official WMDR2 bundled schema; deliberate devt extensions and divergences are isolated in local modules.",
  "type": "object",
  "required": [
    "type",
    "id",
    "conformsTo",
    "geometry",
    "properties"
  ],
  "properties": {
    "id": {
      "$ref": "https://raw.githubusercontent.com/wmo-im/wmdr2/d30f13c3be6395466a778360c4a4ef59625be6af/schemas/wmdr2-bundled.json#/properties/id"
    },
    "conformsTo": {
      "$ref": "https://raw.githubusercontent.com/wmo-im/wmdr2/d30f13c3be6395466a778360c4a4ef59625be6af/schemas/wmdr2-bundled.json#/properties/conformsTo"
    },
    "type": {
      "$ref": "https://raw.githubusercontent.com/wmo-im/wmdr2/d30f13c3be6395466a778360c4a4ef59625be6af/schemas/wmdr2-bundled.json#/properties/type"
    },
    "geometry": {
      "oneOf": [
        {
          "$ref": "https://raw.githubusercontent.com/wmo-im/wmdr2/d30f13c3be6395466a778360c4a4ef59625be6af/schemas/wmdr2-bundled.json#/properties/geometry"
        },
        {
          "type": "null"
        }
      ]
    },
    "time": {
      "oneOf": [
        {
          "$ref": "wmdr2-common.schema.json#/$defs/timeObject"
        },
        {
          "type": "null"
        }
      ]
    },
    "temporalGeometry": {
      "$ref": "wmdr2-common.schema.json#/$defs/temporalGeometry"
    },
    "properties": {
      "$ref": "wmdr2-facility-properties.schema.json"
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "https://raw.githubusercontent.com/wmo-im/wmdr2/d30f13c3be6395466a778360c4a4ef59625be6af/schemas/wmdr2-bundled.json#/properties/links/items"
      }
    }
  },
  "additionalProperties": true
}
