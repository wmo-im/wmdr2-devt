{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wmo-im.github.io/wmdr2-devt/schemas/wmdr2-common.schema.json",
  "title": "WMDR2 development common definitions",
  "$comment": "Common definitions for wmdr2-devt. Where an official WMDR2 definition exists, the development schemas reference the pinned official bundled schema at d30f13c3be6395466a778360c4a4ef59625be6af; these definitions cover devt extensions and explicit tightenings.",
  "$defs": {
    "controlledConcept": {
      "allOf": [
        {
          "$ref": "https://raw.githubusercontent.com/wmo-im/wmdr2/d30f13c3be6395466a778360c4a4ef59625be6af/schemas/wmdr2-bundled.json#/definitions/Observations/properties/observedProperty"
        },
        {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://"
            }
          }
        }
      ]
    },
    "controlledConceptOrNull": {
      "oneOf": [
        {
          "$ref": "#/$defs/controlledConcept"
        },
        {
          "type": "null"
        }
      ]
    },
    "dates": {
      "$ref": "https://raw.githubusercontent.com/wmo-im/wmdr2/d30f13c3be6395466a778360c4a4ef59625be6af/schemas/wmdr2-bundled.json#/properties/properties/properties/territories/items/properties/dates"
    },
    "timeObject": {
      "type": "object",
      "properties": {
        "date": {
          "$ref": "https://raw.githubusercontent.com/wmo-im/wcmp2/f05037aa8d8bf5911a44a511b7b99a0be009c9ab/schemas/wcmpRecordGeoJSON.yaml#/properties/time/oneOf/1/properties/date"
        },
        "timestamp": {
          "$ref": "https://raw.githubusercontent.com/wmo-im/wcmp2/f05037aa8d8bf5911a44a511b7b99a0be009c9ab/schemas/wcmpRecordGeoJSON.yaml#/properties/time/oneOf/1/properties/timestamp"
        },
        "interval": {
          "$ref": "https://raw.githubusercontent.com/wmo-im/wcmp2/f05037aa8d8bf5911a44a511b7b99a0be009c9ab/schemas/wcmpRecordGeoJSON.yaml#/properties/time/oneOf/1/properties/interval"
        },
        "resolution": {
          "$ref": "#/$defs/iso8601Duration"
        }
      },
      "anyOf": [
        {
          "required": [
            "date"
          ]
        },
        {
          "required": [
            "timestamp"
          ]
        },
        {
          "required": [
            "interval"
          ]
        }
      ],
      "additionalProperties": true,
      "$comment": "WCMP date/timestamp/interval are reused directly. resolution is validated locally because the pinned upstream WCMP YAML contains an over-escaped ISO-8601 duration regexp."
    },
    "timePeriod": {
      "type": "object",
      "required": [
        "interval"
      ],
      "properties": {
        "interval": {
          "$ref": "https://raw.githubusercontent.com/wmo-im/wcmp2/f05037aa8d8bf5911a44a511b7b99a0be009c9ab/schemas/wcmpRecordGeoJSON.yaml#/properties/time/oneOf/1/properties/interval"
        },
        "resolution": {
          "$ref": "#/$defs/iso8601Duration"
        }
      },
      "additionalProperties": true,
      "$comment": "WMDR2 temporal period: official WCMP interval structure plus the corrected local ISO-8601 duration constraint for resolution."
    },
    "dateField": {
      "type": "object",
      "properties": {
        "time": {
          "$ref": "#/$defs/timePeriod"
        },
        "date": false
      },
      "additionalProperties": true
    },
    "link": {
      "$ref": "https://raw.githubusercontent.com/wmo-im/wmdr2/d30f13c3be6395466a778360c4a4ef59625be6af/schemas/wmdr2-bundled.json#/properties/links/items"
    },
    "contactAssignment": {
      "type": "object",
      "required": [
        "contact",
        "roles"
      ],
      "properties": {
        "contact": {
          "type": "string",
          "pattern": "^contact:",
          "description": "Reference to properties.contacts[].identifier."
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "temporalGeometry": {
      "type": "object",
      "required": [
        "type",
        "coordinates",
        "dates"
      ],
      "properties": {
        "type": {
          "const": "MovingPoint"
        },
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          }
        },
        "dates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "const": ".."
              }
            ]
          }
        },
        "methods": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/controlledConcept"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "observedFeature": {
      "type": "object",
      "required": [
        "domain"
      ],
      "properties": {
        "domain": {
          "$ref": "#/$defs/controlledConceptOrNull"
        },
        "domainFeature": {
          "$ref": "#/$defs/controlledConcept"
        },
        "featureName": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "surfaceCover": {
      "type": "object",
      "required": [
        "value",
        "scheme"
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/controlledConcept"
        },
        "scheme": {
          "$ref": "#/$defs/controlledConcept"
        }
      },
      "additionalProperties": false
    },
    "topographyBathymetry": {
      "type": "object",
      "properties": {
        "localTopography": {
          "$ref": "#/$defs/controlledConcept"
        },
        "relativeElevation": {
          "$ref": "#/$defs/controlledConcept"
        },
        "topographicContext": {
          "$ref": "#/$defs/controlledConcept"
        },
        "altitudeOrDepth": {
          "$ref": "#/$defs/controlledConcept"
        }
      },
      "anyOf": [
        {
          "required": [
            "localTopography"
          ]
        },
        {
          "required": [
            "relativeElevation"
          ]
        },
        {
          "required": [
            "topographicContext"
          ]
        },
        {
          "required": [
            "altitudeOrDepth"
          ]
        }
      ],
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "properties": {
        "climateZone": {
          "$ref": "#/$defs/controlledConcept"
        },
        "surfaceCover": {
          "$ref": "#/$defs/surfaceCover"
        },
        "surfaceRoughness": {
          "$ref": "#/$defs/controlledConcept"
        },
        "population": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": [
              "number",
              "null"
            ]
          },
          "contains": {
            "type": "number"
          },
          "minContains": 1
        },
        "perimeter_km": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": [
              "number",
              "null"
            ]
          },
          "contains": {
            "type": "number"
          },
          "minContains": 1
        },
        "topographyBathymetry": {
          "$ref": "#/$defs/topographyBathymetry"
        },
        "time": {
          "$ref": "#/$defs/timePeriod"
        },
        "date": false
      },
      "anyOf": [
        {
          "required": [
            "climateZone"
          ]
        },
        {
          "required": [
            "surfaceCover"
          ]
        },
        {
          "required": [
            "surfaceRoughness"
          ]
        },
        {
          "required": [
            "population"
          ]
        },
        {
          "required": [
            "perimeter_km"
          ]
        },
        {
          "required": [
            "topographyBathymetry"
          ]
        }
      ],
      "additionalProperties": true
    },
    "observingProcedure": {
      "type": "object",
      "required": [
        "time",
        "observingSchedules"
      ],
      "properties": {
        "strategy": {
          "$ref": "#/$defs/controlledConcept"
        },
        "observingSchedules": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^schedule_"
          }
        },
        "time": {
          "$ref": "#/$defs/timePeriod"
        },
        "date": false,
        "beginPosition": false,
        "endPosition": false,
        "validFrom": false,
        "validTo": false
      },
      "additionalProperties": true
    },
    "reportingProcedure": {
      "type": "object",
      "required": [
        "internationalExchange",
        "dataPolicy"
      ],
      "properties": {
        "dataFormat": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/controlledConcept"
          }
        },
        "dataPolicy": {
          "$ref": "#/$defs/controlledConceptOrNull"
        },
        "internationalExchange": {
          "type": "boolean"
        },
        "levelOfData": {
          "$ref": "#/$defs/controlledConcept"
        },
        "numberOfObservationsInReportingInterval": {
          "type": [
            "number",
            "integer",
            "string",
            "null"
          ]
        },
        "referenceDatum": {
          "$ref": "#/$defs/controlledConcept"
        },
        "referenceTimeSource": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/controlledConcept"
          }
        },
        "spatialReportingInterval": {
          "type": "string"
        },
        "strategy": {
          "$ref": "#/$defs/controlledConcept"
        },
        "timeliness": {
          "type": [
            "string",
            "null"
          ]
        },
        "timeStampMeaning": {
          "$ref": "#/$defs/controlledConcept"
        },
        "uom": {
          "$ref": "#/$defs/controlledConcept"
        },
        "reportingSchedules": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^schedule_"
          }
        },
        "temporalReportingInterval": {
          "$ref": "#/$defs/iso8601Duration"
        },
        "temporalAggregate": {
          "$ref": "#/$defs/iso8601Duration"
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          }
        },
        "contactAssignments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contactAssignment"
          }
        },
        "time": false,
        "date": false,
        "beginPosition": false,
        "endPosition": false,
        "validFrom": false,
        "validTo": false
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "internationalExchange": {
                "const": true
              }
            },
            "required": [
              "internationalExchange"
            ]
          },
          "then": {
            "required": [
              "temporalReportingInterval"
            ]
          }
        }
      ],
      "additionalProperties": true
    },
    "officialStatus": {
      "type": "object",
      "required": [
        "officialStatus",
        "time"
      ],
      "properties": {
        "officialStatus": {
          "$ref": "#/$defs/controlledConcept"
        },
        "time": {
          "$ref": "#/$defs/timePeriod"
        },
        "date": false
      },
      "additionalProperties": true
    },
    "schedule": {
      "type": "object",
      "required": [
        "uid",
        "start"
      ],
      "properties": {
        "uid": {
          "type": "string",
          "pattern": "^schedule_"
        },
        "@type": {
          "type": "string"
        },
        "start": {
          "type": "string",
          "minLength": 1
        },
        "duration": {
          "$ref": "#/$defs/iso8601Duration"
        },
        "recurrenceRules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "frequency"
            ],
            "properties": {
              "@type": {
                "const": "RecurrenceRule"
              },
              "frequency": {
                "enum": [
                  "yearly",
                  "monthly",
                  "weekly",
                  "daily",
                  "hourly",
                  "minutely",
                  "secondly"
                ]
              },
              "interval": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": true
          }
        },
        "recurrenceOverrides": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true
        },
        "timeZone": {
          "type": "string"
        },
        "wmo.int:samplingFrequency": {
          "$ref": "#/$defs/iso8601Duration"
        },
        "wmo.int:aggregationInterval": {
          "$ref": "#/$defs/iso8601Duration"
        },
        "wmo.int:diurnalBaseTime": {
          "type": "string",
          "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d$"
        }
      },
      "anyOf": [
        {
          "required": [
            "duration"
          ]
        },
        {
          "required": [
            "recurrenceRules"
          ]
        },
        {
          "required": [
            "wmo.int:samplingFrequency"
          ]
        },
        {
          "required": [
            "wmo.int:aggregationInterval"
          ]
        }
      ],
      "additionalProperties": true
    },
    "iso8601Duration": {
      "type": "string",
      "pattern": "^(-?)P(?=\\d|T\\d)(?:(\\d+)Y)?(?:(\\d+)M)?(?:(\\d+)([DW]))?(?:T(?:(\\d+)H)?(?:(\\d+)M)?(?:(\\d+(?:\\.\\d+)?)S)?)?$"
    }
  }
}
